// Default settings for oxide-text. Do not edit this file.
// Put your changes in settings.jsonc in the config folder.
{
  // "system", "light", or "dark"
  "theme": "system",
  "editor": {
    "fontSize": 14,
    "wordWrap": true
  },
  "files": {
    // Line ending for a new file: "lf", "crlf", or "cr"
    "defaultEol": "lf"
  }
}
